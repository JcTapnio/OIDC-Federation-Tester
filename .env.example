PORT=8080
APP_IDS=app1,app2,app3
OIDC_TLS_INSECURE=true

# Optional global TLS settings
# OIDC_CA_FILE=path/to/ca.pem
# OIDC_HTTP_TIMEOUT=15000

# --- App 1 ---
APP1_PORT=8081
APP1_LABEL=App One
APP1_ISSUER=https://cdc-dev.example.org/oidc/op/v1.0/<apiKey1>/
APP1_CLIENT_ID=your_app1_client_id
APP1_CLIENT_SECRET=your_app1_client_secret
APP1_GIGYA_API_KEY=<apiKey1>
# Optional; defaults to http://localhost:8081/login/callback
# APP1_REDIRECT_URI=

# --- App 2 ---
APP2_PORT=8082
APP2_LABEL=App Two
APP2_ISSUER=https://cdc-dev.example.org/oidc/op/v1.0/<apiKey2>/
APP2_CLIENT_ID=your_app2_client_id
APP2_CLIENT_SECRET=your_app2_client_secret
APP2_GIGYA_API_KEY=<apiKey2>
# APP2_REDIRECT_URI=

# --- App 3 ---
APP3_PORT=8083
APP3_LABEL=App Three
APP3_ISSUER=https://cdc-dev.example.org/oidc/op/v1.0/<apiKey3>/
APP3_CLIENT_ID=your_app3_client_id
APP3_CLIENT_SECRET=your_app3_client_secret
APP3_GIGYA_API_KEY=<apiKey3>
# APP3_REDIRECT_URI=
